      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "qinuNuzvvqMt1qAb",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "7dc2201a-c12e-4193-ac37-2756e0c10c4e",
              "leftValue": "={{ $json.output}}",
              "rightValue": "\"is_important\": true",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        640,
        -112
      ],
      "id": "26767fd8-0a54-4b0f-bb76-58a69f84c8e0",
      "name": "Filter"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst tasks = [];\n\nitems.forEach((item, index) => {\n  try {\n    const parsed = JSON.parse(item.json.output);\n    \n    if (parsed.is_important === true && parsed.action_items) {\n      parsed.action_items.forEach(actionItem => {\n        tasks.push({\n          task: actionItem.task,\n          summary: parsed.summary,\n          deadline: actionItem.deadline\n        });\n      });\n    }\n  } catch (error) {\n    console.error(`Error parsing item ${index}:`, error);\n  }\n});\n\n// Return each task as a separate item\nreturn tasks.map(task => ({ json: task }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
