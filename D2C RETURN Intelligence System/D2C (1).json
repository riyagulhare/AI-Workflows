        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  return {\n    json: JSON.parse(item.json.output)\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        -96
      ],
      "id": "cb4bf787-0e92-4cf6-9a11-d68ac6954d2a",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const result = {};\n\nitems.forEach(item => {\n  const product = item.json.product_name;\n  const category = item.json.product_category;\n  const issues = item.json.issues || [];\n\n  if (!result[product]) {\n    result[product] = {\n      product_name: product,\n      product_category: category,\n      total_issues: 0,\n      issue_map: {}\n    };\n  }\n\n  issues.forEach(issue => {\n    if (!issue) return; // safety check\n\n    if (!result[product].issue_map[issue]) {\n      result[product].issue_map[issue] = 0;\n    }\n\n    result[product].issue_map[issue] += 1;\n    result[product].total_issues += 1;\n  });\n});\n\nreturn Object.values(result).map(product => ({\n  json: {\n    product_name: product.product_name,\n    product_category: product.product_category,\n    total_issues: product.total_issues,\n    issues: Object.entries(product.issue_map).map(([issue, count]) => ({\n      issue,\n      count\n    }))\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -96
      ],
      "id": "c4f13cd2-6191-4490-9f66-bb8172144082",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n  const total = data.total_issues;\n\n  let topIssue = \"\";\n  let maxCount = 0;\n\n  const issuesWithPercent = data.issues.map(i => {\n    const percent = ((i.count / total) * 100).toFixed(1);\n\n    if (i.count > maxCount) {\n      maxCount = i.count;\n      topIssue = i.issue;\n    }\n\n    return {\n      issue: i.issue,\n      count: i.count,\n      percentage: percent + \"%\"\n    };\n  });\n\n  return {\n    json: {\n      product_name: data.product_name,\n      product_category: data.product_category,\n      total_issues: total,\n      top_issue: topIssue,\n      issues: issuesWithPercent\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -96
      ],
      "id": "b099e500-4390-413a-ae2e-9da5459a0e32",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior product analyst at an e-commerce company.\n\nYour goal is to generate sharp, non-generic, data-driven insights and recommendations.\n\nSTRICT RULES:\n- Return ONLY valid JSON\n- Do NOT leave any field empty\n- Recommendations must be SPECIFIC and ACTIONABLE (no generic advice)\n- Base reasoning on issue distribution and percentages\n\nGUIDELINES:\n- Insight: Explain what the issue pattern reveals about product, operations, or customer experience\n- Recommendation: Suggest a concrete action (feature, process change, or experiment)\n- Avoid generic phrases like \"improve quality\" or \"enhance experience\"\n\nReturn this structure:\n\n{\n  \"product\": \"\",\n  \"product_category\": \"\",\n  \"total_issues\": 0,\n  \"top_issue\": \"\",\n  \"issues\": [\n    {\n      \"issue\": \"\",\n      \"count\": 0,\n      \"percentage\": \"\"\n    }\n  ],\n  \"insight\": \"\",\n  \"recommendation\": \"\"\n}\n\nInput:\nProduct: {{ $json[\"product_name\"] }}\nProduct_Category: {{ $json[\"product_category\"] }}\nTotal_Issues: {{ $json[\"total_issues\"] }}\nTop_Issue: {{ $json[\"top_issue\"] }}\nIssue_Breakdown: {{$json[\"issues\"] }}\n\nNow generate highly specific, non-generic output.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1408,
