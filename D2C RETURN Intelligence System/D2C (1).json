    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const raw = item.json.output;\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch (error) {\n    parsed = {\n      error: \"Invalid JSON\",\n      raw_output: raw\n    };\n  }\n\n  return {\n    json: parsed\n  };\n});"
      },
